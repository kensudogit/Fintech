# Application
APP_NAME=Fintech AI Platform
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://fintech:fintech_secret@127.0.0.1:15432/fintech_ai
DATABASE_URL_SYNC=postgresql://fintech:fintech_secret@127.0.0.1:15432/fintech_ai

# LLM Provider (openai | google | mock)
LLM_PROVIDER=mock
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# RAG
KNOWLEDGE_DIR=./data/knowledge
VECTOR_COLLECTION=fintech_knowledge
RAG_TOP_K=5

# Personalization
PERSONALIZATION_WINDOW_DAYS=90
MIN_EVENTS_FOR_PROFILE=5

# GCP (optional)
GCP_PROJECT_ID=
GCP_REGION=asia-northeast1
GCP_CREDENTIALS_PATH=./gcp/credentials.json
GCS_BUCKET=
CLOUD_SQL_INSTANCE=
